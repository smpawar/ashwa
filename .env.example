# Copy to .env and fill in the key for the provider you use.

# --- Agent model ---
# anthropic (default) or gemini
ASHWA_LLM_PROVIDER=anthropic
# Claude: get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Gemini: get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Leave empty for the provider default (claude-opus-5-5 / gemini-2.5-flash)
ASHWA_MODEL=
# Claude reasoning effort: low | medium | high | xhigh | max
ASHWA_EFFORT=medium

# --- Embeddings (Anthropic has no embeddings API) ---
# local (default, no key) or gemini. Re-run seed.py after changing.
ASHWA_EMBED_PROVIDER=local
# Leave empty for the provider default (BAAI/bge-small-en-v1.5 / gemini-embedding-001)
ASHWA_EMBED_MODEL=

# openinference (default) or adk: which tracer records ADK's LLM and tool steps
ASHWA_TRACE_SOURCE=openinference

# --- Local Langfuse ---
LANGFUSE_PUBLIC_KEY=pk-lf-local-test
LANGFUSE_SECRET_KEY=sk-lf-local-test
LANGFUSE_HOST=http://localhost:3000

# --- Application database (docker-compose.yml in this folder) ---
APP_DB_DSN=postgresql://ashwa:ashwa@localhost:5433/support

# --- Langfuse ClickHouse, for ashwa_report.py ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
